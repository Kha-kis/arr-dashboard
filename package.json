{
	"name": "arr-dashboard-platform",
	"version": "2.24.1",
	"private": true,
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"setup:worktree": "pnpm install --frozen-lockfile",
		"dev": "turbo run dev --parallel",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"format": "turbo run format",
		"validate:pr": "pnpm run format && pnpm --filter @arr/shared build && pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run test:pr-review-contract",
		"check:prisma-generated": "node scripts/check-prisma-generated.mjs",
		"check:pr-review-contract": "node scripts/check-pr-review-contract.mjs",
		"test:pr-review-contract": "node --test scripts/check-pr-review-contract.test.mjs",
		"clean": "turbo prune --scope='@arr/*' --docker",
		"e2e:integration:up": "cd e2e/integration && docker compose up -d --build && bash bootstrap-services.sh",
		"e2e:integration": "playwright test --config=e2e/integration/playwright.integration.config.ts",
		"e2e:integration:down": "cd e2e/integration && bash teardown.sh",
		"e2e:authentik:up": "cd e2e/authentik-test && docker compose --project-name arr-dashboard-authentik-e2e down -v --remove-orphans && docker compose --project-name arr-dashboard-authentik-e2e up -d --build && bash bootstrap.sh",
		"e2e:authentik": "playwright test --config=e2e/authentik-test/playwright.config.ts",
		"e2e:authentik:down": "cd e2e/authentik-test && docker compose --project-name arr-dashboard-authentik-e2e down -v --remove-orphans"
	},
	"pnpm": {
		"overrides": {
			"@babel/core@<=7.29.0": "7.29.6",
			"browserslist@<4.28.7": "4.28.7",
			"deepmerge-ts@<8.0.0": "8.0.0",
			"esbuild@>=0.27.3 <0.28.1": "0.28.1",
			"lodash@<4.18.1": "4.18.1",
			"hono@<4.12.27": "4.12.27",
			"@hono/node-server@<2.0.5": "2.0.5",
			"fast-uri@>=3.0.0 <3.1.5": "3.1.5",
			"fast-uri@>=4.0.0 <4.1.2": "4.1.2",
			"postcss@<8.5.23": "8.5.23",
			"nanoid@<3.3.18": "3.3.18",
			"dompurify@<=3.4.12": "3.4.13",
			"minimatch@<3.1.4": "3.1.4",
			"minimatch@>=9.0.0 <9.0.7": "9.0.7",
			"minimatch@>=10.0.0 <10.2.3": "10.2.3",
			"mysql2@<3.22.0": "3.22.0",
			"ajv@<6.14.0": "6.14.0",
			"rollup@>=4.0.0 <4.59.0": "4.59.0",
			"undici@>=7.0.0 <7.29.0": "7.29.0",
			"valibot@<1.4.2": "1.4.2",
			"find-my-way@<9.7.0": "9.7.0",
			"flatted@<3.4.2": "3.4.2",
			"effect@<3.20.0": "3.20.0",
			"picomatch@>=4.0.0 <4.0.4": "4.0.4",
			"picomatch@>=2.0.0 <2.3.2": "2.3.2",
			"yaml": "2.8.3",
			"brace-expansion@>=1.0.0 <1.1.18": "1.1.18",
			"brace-expansion@>=2.0.0 <2.1.2": "2.1.2",
			"brace-expansion@>=3.0.0 <5.0.9": "5.0.9",
			"sharp@<0.35.0": "0.35.3",
			"defu@<=6.1.4": "6.1.5",
			"vite": "7.3.5"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@playwright/test": "^1.61.1",
		"dotenv": "^17.4.2",
		"eslint-plugin-unused-imports": "^4.4.1",
		"knip": "^6.27.0",
		"turbo": "^2.10.5",
		"typescript": "^6.0.3"
	}
}
