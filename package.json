{
	"name": "arr-dashboard-platform",
	"version": "2.24.1",
	"private": true,
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"setup:worktree": "pnpm install --frozen-lockfile",
		"dev": "turbo run dev --parallel",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"typecheck": "turbo run typecheck",
		"test": "pnpm run test:dependency-patches && turbo run test && pnpm run test:jellyfin-authority-contract && pnpm run test:e2e-ui-contract",
		"test:dependency-patches": "node --test scripts/check-braces-depth.test.mjs",
		"format": "turbo run format",
		"validate:pr": "pnpm run format && pnpm --filter @arr/shared build && pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run test:pr-review-contract",
		"check:prisma-generated": "node scripts/check-prisma-generated.mjs",
		"check:pr-review-contract": "node scripts/check-pr-review-contract.mjs",
		"test:pr-review-contract": "node --test scripts/check-pr-review-contract.test.mjs",
		"clean": "turbo prune --scope='@arr/*' --docker",
		"e2e:integration:up": "cd e2e/integration && docker compose up -d --build && bash bootstrap-services.sh",
		"e2e:integration": "playwright test --config=e2e/integration/playwright.integration.config.ts",
		"e2e:integration:down": "cd e2e/integration && bash teardown.sh",
		"e2e:authentik:up": "cd e2e/authentik-test && docker compose --project-name arr-dashboard-authentik-e2e down -v --remove-orphans && docker compose --project-name arr-dashboard-authentik-e2e up -d --build && bash bootstrap.sh",
		"e2e:authentik": "playwright test --config=e2e/authentik-test/playwright.config.ts",
		"e2e:authentik:down": "cd e2e/authentik-test && docker compose --project-name arr-dashboard-authentik-e2e down -v --remove-orphans",
		"test:jellyfin-authority-contract": "pnpm --filter @arr/shared build && node --test e2e/jellyfin-authority/live-matrix-lib.test.mjs e2e/jellyfin-authority/domain-profile.test.mjs e2e/jellyfin-authority/rejection.test.mjs",
		"test:e2e-ui-contract": "node --test e2e/contracts/calendar-dashboard.test.mjs e2e/contracts/search-trash.test.mjs e2e/contracts/runner-selection.test.mjs"
	},
	"pnpm": {
		"overrides": {
			"@babel/core@<=7.29.0": "7.29.6",
			"browserslist@<4.28.7": "4.28.7",
			"deepmerge-ts@<8.0.0": "8.0.0",
			"esbuild@>=0.27.3 <0.28.1": "0.28.1",
			"lodash@<4.18.1": "4.18.1",
			"hono@<4.12.27": "4.12.27",
			"@hono/node-server@<2.0.5": "2.0.5",
			"fast-uri@>=3.0.0 <3.1.9": "3.1.9",
			"fast-uri@>=4.0.0 <4.2.3": "4.2.3",
			"postcss@<8.5.23": "8.5.23",
			"nanoid@<3.3.18": "3.3.18",
			"dompurify@>=3.0.0 <3.4.17": "3.4.17",
			"minimatch@<3.1.4": "3.1.4",
			"minimatch@>=9.0.0 <9.0.7": "9.0.7",
			"minimatch@>=10.0.0 <10.2.3": "10.2.3",
			"mysql2@>=3.0.0 <3.23.1": "3.23.1",
			"ajv@<6.14.0": "6.14.0",
			"rollup@>=4.0.0 <4.59.0": "4.59.0",
			"undici@>=7.0.0 <7.30.1": "7.30.1",
			"zod@>=4.0.0 <4.6.6": "4.6.6",
			"valibot@<1.4.2": "1.4.2",
			"find-my-way@<9.7.0": "9.7.0",
			"flatted@<3.4.2": "3.4.2",
			"effect@<3.20.0": "3.20.0",
			"picomatch@>=4.0.0 <4.0.4": "4.0.4",
			"picomatch@>=2.0.0 <2.3.2": "2.3.2",
			"yaml": "2.8.3",
			"brace-expansion@>=1.0.0 <1.1.21": "1.1.21",
			"brace-expansion@>=2.0.0 <2.1.2": "2.1.2",
			"brace-expansion@>=3.0.0 <5.0.12": "5.0.12",
			"sharp@<0.35.5": "0.35.5",
			"source-map-js@>=1.0.0 <1.2.2": "1.2.2",
			"smol-toml@>=1.0.0 <1.9.0": "1.9.0",
			"baseline-browser-mapping@>=2.0.0 <2.11.0": "2.11.19",
			"defu@<=6.1.4": "6.1.5",
			"vite": "7.3.7",
			"tsup@8.5.1>chokidar": "5.0.0",
			"@babel/core@7.29.6>semver": "7.8.5",
			"@babel/helper-compilation-targets@7.28.6>semver": "7.8.5",
			"eslint-plugin-react@7.37.5>semver": "7.8.5",
			"node-exports-info@1.6.0>semver": "7.8.5",
			"sucrase@3.35.1>tinyglobby": "0.2.15"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@playwright/test": "^1.61.1",
		"dotenv": "^17.4.2",
		"eslint-plugin-unused-imports": "^4.4.1",
		"knip": "^6.27.0",
		"turbo": "^2.10.5",
		"typescript": "^6.0.3"
	}
}
