diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,47 @@
+'use strict';
+
+// Local security backport for braces3.0.3. Never raised or disabled by options.
+const MAX_DEPTH = 128;
+const fail = () => {
+  const error = new RangeError('Brace structure exceeds maximum depth of 128');
+  error.code = 'ERR_BRACES_MAX_DEPTH';
+  throw error;
+};
+
+exports.assertDepth = depth => {
+  if (depth > MAX_DEPTH) fail();
+};
+
+exports.assertArrayDepth = value => {
+  const pending = [{ value, depth: 0 }];
+  while (pending.length) {
+    const frame = pending.pop();
+    if (!Array.isArray(frame.value)) continue;
+    if (frame.depth > MAX_DEPTH) fail();
+    for (const child of frame.value) {
+      if (Array.isArray(child)) pending.push({ value: child, depth: frame.depth + 1 });
+    }
+  }
+};
+
+exports.assertAstDepth = ast => {
+  const pending = [{ node: ast, depth: 0 }];
+  while (pending.length) {
+    const { node, depth } = pending.pop();
+    if (depth > MAX_DEPTH) fail();
+    if (!node || typeof node !== 'object') continue;
+    const parents = new Set();
+    let parent = node;
+    let parentDepth = 0;
+    while (parent && typeof parent === 'object') {
+      if (parents.has(parent) || parentDepth > MAX_DEPTH) fail();
+      parents.add(parent);
+      parent = parent.parent;
+      parentDepth++;
+    }
+    exports.assertArrayDepth(node.value);
+    if (node.nodes) {
+      for (const child of node.nodes) pending.push({ node: child, depth: depth + 1 });
+    }
+  }
+};
