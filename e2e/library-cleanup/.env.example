# Set a unique project name for every live run. Generic names such as
# lc-e2e-local, lc-e2e-test, and lc-e2e-default are rejected by live preflights.
# Example: lc-e2e-616-20260803-153000
COMPOSE_PROJECT_NAME=

TZ=Etc/UTC
PUID=1000
PGID=1000
HARNESS_SUBNET=172.31.250.0/24

# Image defaults are intentionally overridable for repeatable compatibility runs.
RADARR_IMAGE=lscr.io/linuxserver/radarr:latest
SONARR_IMAGE=lscr.io/linuxserver/sonarr:latest
PLEX_IMAGE=lscr.io/linuxserver/plex:latest
QBITTORRENT_IMAGE=lscr.io/linuxserver/qbittorrent:latest
# qUI is deliberately allowlisted by the safety checker. See README before bumping.
QUI_IMAGE=ghcr.io/autobrr/qui:v1.16.1
POSTGRES_IMAGE=postgres:16-alpine
TOXIPROXY_IMAGE=ghcr.io/shopify/toxiproxy:2.12.0
CANDIDATE_DASHBOARD_IMAGE=arr-dashboard-library-cleanup:local
BASELINE_DASHBOARD_IMAGE=khak1s/arr-dashboard:2.23.0

# These files are ignored by git. The PostgreSQL password must contain only
# URL-safe characters: A-Z, a-z, 0-9, dot, underscore, tilde, or hyphen.
POSTGRES_PASSWORD_FILE=./secrets/postgres-password.txt
PLEX_CLAIM_FILE=./secrets/plex-claim.txt

# Only dashboard entrypoints are published by the base Compose file.
DASHBOARD_SQLITE_PORT=33030
DASHBOARD_POSTGRES_PORT=33031
DASHBOARD_BASELINE_PORT=33032

# Optional loopback ports used only with compose.debug.yml.
RADARR_A_PORT=17878
RADARR_B_PORT=27878
SONARR_A_PORT=18989
SONARR_B_PORT=28989
PLEX_PORT=32400
QBITTORRENT_A_PORT=18080
QBITTORRENT_B_PORT=28080
QUI_A_PORT=17476
QUI_B_PORT=27476
TOXIPROXY_PORT=18474
POSTGRES_PORT=15432
